{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "components/social/**",
              "ui_kits/instagram/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Mona Sans Black|Degular Display|Mona Sans))/i]",
        "message": "Font not provided by the design system. Available: Mona Sans Black, Degular Display, Mona Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|iconRight|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, iconRight, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|inverse|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'inverse' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m|l)$/]",
        "message": "<Button> size must be one of 's' | 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|title|children|media|padding|radius|elevated|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, eyebrow, title, children, media, padding, radius, elevated, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|tint|brand|dark)$/]",
        "message": "<Card> tone must be one of 'white' | 'tint' | 'brand' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|multi|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ChoiceOption> doesn't accept that prop. Declared props: label, selected, multi, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Illustration'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|width|height|fit|base|alt|style|key|ref|className|style|children)$/]",
        "message": "<Illustration> doesn't accept that prop. Declared props: name, width, height, fit, base, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Illustration'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:omino-zoom|omino-zoom-1|omino-1|omino-2|omino-annoiato|omino-appoggiato|omino-appoggiato-2|omino-cade|omino-caffe|omino-cucu|omino-centro|omino-bici|livello-1-10|batti-8|batti-pasta|mani-e-piedi|mano-16|mano-17|mano-18|mano-19|mano-20|mano-21|mano-22|mano-23|mano-alt|mano-alt-1|mano-alt-2|mano-gratis|mano-sconto)$/]",
        "message": "<Illustration> name must be one of 'omino-zoom' | 'omino-zoom-1' | 'omino-1' | 'omino-2' | 'omino-annoiato' | 'omino-appoggiato' | 'omino-appoggiato-2' | 'omino-cade' | 'omino-caffe' | 'omino-cucu' | 'omino-centro' | 'omino-bici' | 'livello-1-10' | 'batti-8' | 'batti-pasta' | 'mani-e-piedi' | 'mano-16' | 'mano-17' | 'mano-18' | 'mano-19' | 'mano-20' | 'mano-21' | 'mano-22' | 'mano-23' | 'mano-alt' | 'mano-alt-1' | 'mano-alt-2' | 'mano-gratis' | 'mano-sconto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Illustration'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:contain|cover)$/]",
        "message": "<Illustration> fit must be one of 'contain' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|vertical|layout|height|base|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, color, vertical, layout, height, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:logo|payoff|mark)$/]",
        "message": "<Logo> variant must be one of 'logo' | 'payoff' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:violet|black|white)$/]",
        "message": "<Logo> color must be one of 'violet' | 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:horizontal|compact)$/]",
        "message": "<Logo> layout must be one of 'horizontal' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|format|showLogo|align|scale|base|children|style|key|ref|className|style|children)$/]",
        "message": "<SocialSlide> doesn't accept that prop. Declared props: tone, format, showLogo, align, scale, base, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialSlide'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|tint|lilac|violet|dark)$/]",
        "message": "<SocialSlide> tone must be one of 'white' | 'tint' | 'lilac' | 'violet' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialSlide'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:portrait|square|story)$/]",
        "message": "<SocialSlide> format must be one of 'portrait' | 'square' | 'story'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialSlide'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SocialSlide> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute > JSXIdentifier[name!=/^(?:marker|children|sub|size|style|key|ref|className|style|children)$/]",
        "message": "<Statement> doesn't accept that prop. Declared props: marker, children, sub, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|l|xl)$/]",
        "message": "<Statement> size must be one of 'm' | 'l' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|soft|white|outline|dark)$/]",
        "message": "<Tag> tone must be one of 'brand' | 'soft' | 'white' | 'outline' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m|l)$/]",
        "message": "<Tag> size must be one of 's' | 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|hint|error|type|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, placeholder, value, onChange, hint, error, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|password)$/]",
        "message": "<TextField> type must be one of 'text' | 'email' | 'tel' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|shape|flip|height|style|key|ref|className|style|children)$/]",
        "message": "<Wave> doesn't accept that prop. Declared props: color, shape, flip, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:white|violet|lavender)$/]",
        "message": "<Wave> color must be one of 'white' | 'violet' | 'lavender'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:soft|deep)$/]",
        "message": "<Wave> shape must be one of 'soft' | 'deep'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
